{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ismailsardi/Tjuvstart/content/schema/descriptors.schema.json",
  "title": "CEFR descriptor map",
  "type": "object",
  "required": ["source", "descriptors"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "source": { "type": "string", "minLength": 1 },
    "descriptors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "level", "skill", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^(A1|A2|B1|B2)-(R|L|W|S)-[0-9]{2}$" },
          "level": { "enum": ["A1", "A2", "B1", "B2"] },
          "skill": { "enum": ["reading", "listening", "writing", "speaking"] },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
