{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ismailsardi/Tjuvstart/content/schema/lesson.schema.json",
  "title": "Lesson",
  "type": "object",
  "required": ["id", "level", "title", "summary", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "level": {
      "$ref": "#/$defs/level"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "document": {
      "description": "Set when the text imitates a real-world document, simplified to the lesson's level. The app shows it in that form.",
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["letter", "ad", "job-ad", "notice"]
        },
        "from": {
          "description": "Who the document is from, as printed on it.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "text": {
      "description": "Optional reading text shown above the exercises.",
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "level": {
      "enum": ["A1", "A2", "B1", "B2"]
    },
    "item": {
      "type": "object",
      "required": ["id", "type", "skill", "level", "descriptors", "difficulty", "prompt"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "type": {
          "enum": ["multiple-choice", "gap-fill", "word-order", "dictation"]
        },
        "skill": {
          "enum": ["reading", "listening", "writing", "speaking"]
        },
        "level": {
          "$ref": "#/$defs/level"
        },
        "descriptors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "difficulty": {
          "description": "Item difficulty on the engine's rating scale.",
          "type": "integer",
          "minimum": 400,
          "maximum": 2000
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string"
        },
        "audio": {
          "description": "Norwegian text the learner hears instead of reads. Listening items need it; the audio build records it.",
          "type": "string",
          "minLength": 1
        },
        "focus": {
          "description": "Grammar or usage points the item practises. The app tracks repeated mistakes per point and recycles them.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/focus"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "multiple-choice"
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "answer": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["options", "answer"]
        },
        {
          "properties": {
            "type": {
              "const": "gap-fill"
            },
            "answers": {
              "description": "All accepted answers.",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": ["answers"]
        },
        {
          "properties": {
            "type": {
              "const": "word-order"
            },
            "tokens": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "answer": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["tokens", "answer"]
        },
        {
          "properties": {
            "type": {
              "const": "dictation"
            }
          },
          "required": ["audio"],
          "description": "The learner writes down what they hear; the answer is the audio text."
        }
      ],
      "if": {
        "properties": {
          "skill": {
            "const": "listening"
          }
        },
        "required": ["skill"]
      },
      "then": {
        "required": ["audio"]
      }
    },
    "focus": {
      "enum": [
        "v2-word-order",
        "subordinate-clause",
        "ikke-placement",
        "noun-gender",
        "definite-form",
        "object-pronouns",
        "verb-present",
        "modal-verbs",
        "conjunctions",
        "question-words",
        "time-expressions",
        "fixed-expressions"
      ]
    }
  }
}
