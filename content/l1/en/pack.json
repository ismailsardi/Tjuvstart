  "contrasts": [
    {
      "id": "verb-second",
      "title": "The verb comes second",
      "body": "In a Norwegian main clause the verb is always the second element. If you start with a time or place, the subject moves after the verb: «I dag er det min første dag», not «I dag det er…».",
      "lessons": [
        "a2-first-day-at-work",
        "a2-renting-a-flat",
        "a2-getting-around",
        "a2-calling-in-sick",
        "a2-bankid",
        "a2-tax-card",
        "a2-doctor",
        "a2-lunch-small-talk",
        "a2-nav-letter",
        "a2-finn-ad",
        "a2-job-ad",
        "a2-dugnad"
      ]
    },
    {
      "id": "half-past",
      "title": "«Halv tolv» is 11:30",
      "body": "Norwegian counts half an hour towards the next hour. «Halv tolv» means 11:30, not 12:30 as British «half twelve» would.",
      "lessons": ["a2-first-day-at-work", "a2-doctor"]
    },
    {
      "id": "ikke-in-subclause",
      "title": "«Ikke» before the verb after «fordi»",
      "body": "In a main clause «ikke» comes after the verb: «Trikken går ikke». After «fordi», «at» or «hvis» it moves in front of the verb: «…fordi trikken ikke går».",
      "lessons": ["a2-getting-around", "a2-calling-in-sick", "a2-tax-card", "a2-nav-letter"]
    },
    {
      "id": "room-count",
      "title": "«Toroms» counts all rooms",
      "body": "Flat ads count the living room too. A «toromsleilighet» has two rooms: a living room and one bedroom. A «treroms» has two bedrooms.",
      "lessons": ["a2-renting-a-flat"]
    }
  ],
  "itemNotes": {
    "a2-fdw-02": "«Sjef» looks like «chef», but it means boss.",
    "a2-fdw-03": "«Halv tolv» is half an hour before twelve: 11:30.",
    "a2-fdw-11": "After the verb, use the object pronoun: jeg (I) → meg (me).",
    "a2-fdw-13": "The sentence starts with «I dag», so the verb «er» comes next, then the subject «det».",
    "a2-fdw-14": "Same rule: «Etter lunsj» + verb «har» + subject «vi».",
    "a2-fdw-15": "After «fordi» (because) the order is subject, then verb: «kollegene er».",
    "a2-flat-01": "«Toroms» means two rooms in total: the living room and one bedroom.",
    "a2-flat-02": "«Strøm er ikke inkludert»: electricity is not included, so you pay it on top.",
    "a2-flat-04": "«Ingen husdyr» means no pets.",
    "a2-flat-11": "The sentence starts with «Neste måned», so the verb «vil» comes next, then «jeg».",
    "a2-flat-12": "After «fordi» the order is subject, then verb: «den er».",
    "a2-trip-02": "From Monday 3 March to Friday 14 March is two working weeks.",
    "a2-trip-06": "«Står fast» means is stuck, not standing fast.",
    "a2-trip-09": "«Komme for sent» means to be late.",
    "a2-trip-12": "After «fordi», «ikke» goes before the verb: «trikken ikke går».",
    "a2-sick-05": "«God bedring!» is what you say to someone who is ill: get well soon.",
    "a2-sick-06": "In Norway you can usually report yourself sick for a few days. After that you need a note from a doctor, a «sykmelding».",
    "a2-sick-08": "«Time» here means an appointment. «En time» can also mean an hour.",
    "a2-sick-10": "«Så» here means so, as a result: «Jeg er syk, så jeg blir hjemme».",
    "a2-sick-11": "«I morgen» comes first, so the verb «kommer» moves before «jeg».",
    "a2-bid-02": "A D-nummer is a temporary ID number for people who stay in Norway for a shorter time. Skatteetaten gives it out after an ID check.",
    "a2-tax-04": "Without a tax card, the employer must take 50% tax. Order the tax card before your first payday.",
    "a2-doc-03": "«Halv to» is half an hour before two: 13.30.",
    "a2-doc-05": "113 is for medical emergencies. 116 117 (legevakt) is for urgent help when your fastlege is closed.",
    "a2-lunch-04": "Kantina is the workplace canteen. Many Norwegians bring a matpakke instead.",
    "a2-nav-02": "«Hver fjortende dag» means every 14 days, so every two weeks.",
    "a2-finn-05": "«Førstemann til mølla» means first come, first served: whoever comes first gets it.",
    "a2-dug-05": "A dugnad is unpaid shared work for the building, the school or the sports club. People expect neighbours to join.",
    "a2-job-03": "«Fast stilling» is a permanent job; «midlertidig» is temporary."
  },
  "canDo": {
    "A2-R-01": "I can read short, simple texts about everyday life and work.",
    "A2-R-02": "I can find what I need in notices, timetables, menus and ads.",
    "A2-R-03": "I can understand short messages and simple instructions at work.",
    "A2-L-01": "I can follow everyday words and phrases about me and my work when people speak slowly.",
    "A2-L-02": "I can get the main point of short messages and announcements.",
    "A2-W-01": "I can write short notes and messages about what I need.",
    "A2-W-02": "I can write simple sentences about myself and my work, joined with og, men and fordi.",
    "A2-S-01": "I can introduce myself and answer simple questions about my work and background.",
    "A2-S-02": "I can greet, thank, apologise and invite in short conversations.",
    "A2-S-03": "I can ask for and give directions and practical information.",
    "B1-R-01": "I can understand clear factual texts on topics I know.",
    "B1-R-02": "I can understand what people describe in letters and messages: events, feelings, wishes.",
    "B1-L-01": "I can follow the main points of clear speech at work and in daily life.",
    "B1-L-02": "I can follow the main points of the news on familiar topics when it is spoken clearly.",
    "B1-W-01": "I can write a short, connected text on a familiar topic.",
    "B1-W-02": "I can write emails and messages about my experiences.",
    "B1-S-01": "I can handle most everyday and work situations, like appointments and services.",
    "B1-S-02": "I can give reasons for my opinions and plans."
  },
